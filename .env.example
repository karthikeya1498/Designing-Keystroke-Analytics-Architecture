# Local-only convenience flag. Keep false or unset in production.
# AEGISKEY_ALLOW_DEMO_INGEST=true

# Production bearer token for agents or an API gateway. Store it in a secret manager.
# AEGISKEY_INGEST_TOKEN=replace-with-a-long-random-token

# Dashboard login credentials and session signing secret.
# Generate the secret with: openssl rand -hex 32
# AEGISKEY_DASHBOARD_USER=operator
# AEGISKEY_DASHBOARD_PASSWORD=replace-with-a-strong-password
# AEGISKEY_SESSION_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL foundation service.
# DATABASE_URL=postgresql://aegiskey:local-development-only@localhost:5432/aegiskey
# POSTGRES_DB=aegiskey
# POSTGRES_USER=aegiskey
# POSTGRES_PASSWORD=local-development-only
# POSTGRES_PORT=5432

# Optional multi-instance SSE transport. When absent, the app uses the process-local event bus.
# REDIS_URL=redis://localhost:6379
# REDIS_PORT=6379
# ML_PORT=8000
